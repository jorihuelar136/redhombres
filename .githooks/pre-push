#!/usr/bin/env bash
# Pre-push hook to scan for obvious secrets before allowing push.
# Blocks push if patterns are detected in staged commits diff.
# Customize patterns as needed.

set -euo pipefail

# Collect refs being pushed from stdin (local_ref local_sha remote_ref remote_sha)
# We will scan the range of new commits for each ref.

# Patterns (basic). Add more as needed.
PATTERNS=(
  'AIRTABLE_API_KEY='
  'JWT_SECRET='
  'AWS_ACCESS_KEY_ID='
  'AWS_SECRET_ACCESS_KEY='
  'PRIVATE KEY-----'
  'BEGIN RSA PRIVATE KEY'
  'BEGIN OPENSSH PRIVATE KEY'
)

color_red='\033[31m'
color_green='\033[32m'
color_yellow='\033[33m'
color_reset='\033[0m'

error_found=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # If remote ref is blank (new branch) compare against empty tree.
  base_ref="$remote_sha"
  if [ "$remote_sha" = '0000000000000000000000000000000000000000' ]; then
    base_ref="$(git hash-object -t tree /dev/null)" # empty tree
  fi
  # Get list of new commits
  commits=$(git rev-list ${base_ref}..${local_sha}) || true
  for c in $commits; do
    # Show name-status and full diff text in one stream for scanning
    diff_text=$(git show --pretty=format: --name-only "$c"; git show "$c")
    for pattern in "${PATTERNS[@]}"; do
      if echo "$diff_text" | grep -E "$pattern" >/dev/null 2>&1; then
        echo -e "${color_red}SECURITY BLOCK: Pattern '$pattern' found in commit $c${color_reset}" >&2
        error_found=1
      fi
    done
  done
done

if [ $error_found -eq 1 ]; then
  cat <<'EOF' >&2
One or more potential secrets were detected in the commits you are pushing.
Resolve them (remove from history / rotate keys) before pushing again.
To override temporarily (not recommended): git push --no-verify
EOF
  exit 1
fi

echo -e "${color_green}Pre-push secret scan passed.${color_reset}" >&2
exit 0
